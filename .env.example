# Copie para .env e preencha com os valores do seu ambiente.
# Todas as variaveis sao obrigatorias: a aplicacao nao sobe sem elas.

# URL publica da aplicacao, sem barra no final.
# Local: http://localhost:3000 | Producao: https://seu-dominio.com.br
# E para onde o Stripe redireciona o cliente depois do pagamento.
APP_URL="http://localhost:3000"

# Banco de dados (Postgres)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/expenses"

# Clerk (autenticacao)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Stripe (pagamentos)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=""
STRIPE_PREMIUM_PRICE_MONTHLY_ID=""
STRIPE_PREMIUM_PRICE_YEARLY_ID=""
STRIPE_TEST_PRICE_ID=""

# Google Gemini (relatorio de IA)
GEMINI_API_KEY=""
